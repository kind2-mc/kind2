-- The number of true elements among the first k elements of B
opaque function rec count( const n : int ; B : bool^n ; k : int ) returns ( C : int ) ;
(*@contract
  guarantee C >= 0;
  decreases k;
*)
let
  C = when k <= 0 or k > n then 0
      else count(n, B, k-1) + (if B[k-1] then 1 else 0);
tel

node Buffer( const n : int; Init : int ; Request: bool^n; Turn : bool^n; Value : int^n )
returns ( Accepted : bool^n ) ;
(*@contract
  assume n > 0 ;
  assume n <= 4 ;
  
  guarantee "fair" true -> 
   forall (i:int) 0 <= i and i < n =>
    pre Request[i] and not pre Accepted[i] => Accepted[i] ;
*)
let
  Accepted = (Request[i] and (Turn[i] or count(n, Request, n) = 1) foreach i)^n ;
tel
