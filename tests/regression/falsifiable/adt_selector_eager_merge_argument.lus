-- Companion of adt_selector_eager_call_argument.lus for a node call in a lazy
-- when branch.
-- A selector inside the argument of a node call is evaluated on every step
-- of the clock of the call, whatever the eager conditions around the call,
-- since the callee's state advances on every such step: the two reads of x.a
-- below feed the same value to both Sum instances, so their sums agree. The
-- falsifiable properties are the obligations of the unguarded reads.

datatype D = A (a: int) | B (b: bool);

node Sum(v: int) returns (s: int); let s = v -> pre s + v; tel

node main(x: D; c: bool) returns (ok: bool);
var s1: int;
let
  s1 = when c then Sum(x.a) else 0;
  check "same argument, same sum"
    (not A?(x)) or
    ((when c then Sum(x.a) else 0) = s1);
  ok = true;
tel
