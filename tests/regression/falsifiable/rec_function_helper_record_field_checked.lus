type R = struct { f: subtype { w: int | w >= 100 } };
function G(n: int) returns (y: int); let y = (R { f = n }).f; tel
function rec F(n: int) returns (y: int);
(*@contract decreases n; *)
let y = when n <= 0 then 0 else F(n - 1) + 0 * G(n); tel
node N(x: int) returns (y: bool);
let y = (G(x) = x); check y; tel
