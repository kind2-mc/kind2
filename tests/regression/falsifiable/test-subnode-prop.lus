node abs (a: int) returns (b: int);
let
  b = if a > 0 then a else -a;
tel

node X (a: int) returns (b: int);
var OK: bool;
let
  b = 2 * a;
  OK = b >= 0;
  --%PROPERTY OK;
tel

node Y(a: int; clk: bool) returns (b: int);
var OK: bool; b1, b2, held1, held2: int;
let
  held1 = 1 fby b1;
  b1 = when clk then X(abs(a)) else held1;
  held2 = 2 fby b2;
  b2 = when not clk then X(abs(a)) else held2;
  b = b1 + b2;
  OK = b > 1;
  --%PROPERTY OK;
tel

node Z () returns ();
var
  b1,  b2: int;
let
  b1 = Y(0,  true);  
  b2 = Y(1,  true);
  --%PROPERTY (b1 > 0 and b2 < 0);
tel;