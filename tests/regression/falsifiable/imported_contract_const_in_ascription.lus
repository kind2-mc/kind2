-- The actual parameter of a constant input of an imported contract, and the
-- value of a ghost constant, are the bounds checked by a type ascription
-- mentioning them (issue #1648)

contract CParam(const n: int; x: int) returns (y: int);
let
  guarantee ((y : subtype { w: int | w <= n })) = y;
tel

node ImportParam (x: int) returns (y: int);
(*@contract import CParam(10, x) returns (y); *)
let
  y = 11;
tel

contract CGhost(x: int) returns (y: int);
let
  const g: int = 10;
  guarantee ((y : subtype { w: int | w <= g })) = y;
tel

node ImportGhost (x: int) returns (y: int);
(*@contract import CGhost(x) returns (y); *)
let
  y = 11;
tel
