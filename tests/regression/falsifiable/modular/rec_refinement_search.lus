-- A recursive function is a subsystem of itself. After a modular analysis
-- leaves a property of main unproved, the search for a subsystem to refine
-- walks the subsystems of main, and used to walk Fact, then Fact again,
-- forever: the run printed its verdict and then hung until the timeout.
function rec Fact(n: int) returns (f: int);
(*@contract
  guarantee "positive" f > 0;
  decreases n;
*)
let
  f = when n <= 0 then 1 else n * Fact(n - 1);
tel

node main(x: int) returns (y: int);
let
  y = Fact(3);
  check "fact3" y = 6;
tel
