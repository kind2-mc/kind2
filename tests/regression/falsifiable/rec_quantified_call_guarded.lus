-- A call under a quantifier guarded by a condition that depends on the
-- quantified variables (issue #1519): the property does not hold, and is
-- reported falsifiable rather than failing in the solver. The guard of the
-- call to Leftmost does not exclude an Atomic argument, so its selector
-- obligation does not hold either. The call to Size, whose argument is not
-- quantified, is compiled to an application of the function's symbol.

datatype Message = Atomic (v: int) | Pair (fst: Message, snd: Message);

function rec Subterm (x: Message; m: Message) returns (r: bool)
con decreases m; noc
let
  r = x = m or (match m with | Pair (f, s) : Subterm(x, f) or Subterm(x, s) | _ : false end);
tel

-- Its selector obligation holds only if it is never called with an Atomic
function rec Leftmost (m: Message) returns (r: Message)
con decreases m; noc
let
  r = match m with | Pair (f, s) : (if Pair?(f) then Leftmost(f) else f) | _ : m.fst end;
tel

function rec Size (m: Message) returns (r: int)
con decreases m; noc
let
  r = match m with | Pair (f, s) : 1 + Size(f) + Size(s) | _ : 1 end;
tel

node L (m: Message) returns ()
let
  check forall (x: Message) Subterm(x, m) ==> not Subterm(x, m);
  check forall (x: Message) Subterm(x, m) ==> Leftmost(x) = Leftmost(x);
  check forall (x: Message) Subterm(x, m) ==> Size(m) = 1;
tel
