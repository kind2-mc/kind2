node pass(x : int) returns (y : int);
let
  y = 0 -> pre x;
tel;

node main() returns ();
var
  count : int;
  toggle : bool;
  ok : bool;
  slow_count : int;
  held : int;
let
  count = 3 -> 1 + pre count;
  toggle = false -> not pre toggle;
  held = -1 fby slow_count;
  slow_count = when toggle then pass(count) else held;

  ok = slow_count <= 10;
  --%PROPERTY ok;
tel;