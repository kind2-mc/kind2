type t = enum {A, B, C};

node integr (e: int) returns (s: int);
let
  s = e + (0 -> pre s); 
tel

node id (e: int) returns (s: int);
let
  s = e;
tel

node test (e: int; cl: t) returns
 (s, t1: int);
let 
  s = integr(e);
  
  t1 = when cl = A then s
       else when cl = C then integr(e)
       else s - 1;
  --%PROPERTY t1 <= s;
tel
