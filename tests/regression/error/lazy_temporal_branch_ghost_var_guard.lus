-- A guard that mentions a ghost variable of a contract changes over time, so
-- a temporal operand under it is abstracted into a call to a node, which a
-- quantified variable in the guard does not allow (issue #1837)

node main (x: int) returns ();
(*@contract
  var g: int = x;
  guarantee forall (k: int) g = k ==> (true -> pre x > 0);
*)
let
tel
