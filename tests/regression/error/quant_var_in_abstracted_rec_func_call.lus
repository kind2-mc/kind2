-- A recursive function that a contract abstracts has an uninterpreted
-- functional symbol, constrained by the contract at the arguments of its
-- instances only. A call to it applied to a quantified variable is rejected:
-- the symbol would stand for an arbitrary function under the quantifier.

datatype Nat = Zero | Succ (p: Nat);

function rec Even (n: Nat) returns (r: bool)
con
  decreases n;
  guarantee r or not r;
noc
let
  r = match n with | Zero : true | Succ(m) : not Even(m) end;
tel

node main (x: bool) returns (y: bool);
let
  y = x;
  check forall (n: Nat) Even(n) or not Even(n);
tel
