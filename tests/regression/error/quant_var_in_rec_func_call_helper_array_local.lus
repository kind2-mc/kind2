-- A call to a recursive function applied to a quantified variable is rejected
-- when the function calls a non-recursive function that cannot be inlined,
-- here because of an array-typed local variable, as a call to a non-recursive
-- function that calls it is. No definition is built for the callee, so none
-- is built for F either. The call used to be accepted, and this property,
-- which holds, was reported falsifiable.

function H (a: int) returns (r: int);
var t: int^2;
let
  t = [a, a];
  r = t[0];
tel

function rec F (a: int; n: int) returns (r: int);
con decreases n; noc
let
  r = when n <= 0 then H(a) else F(a, n - 1);
tel

node Test (a: int) returns ();
let
  check forall (k: int) k <= 0 => F(a, k) = a;
tel
