-- A quantified variable may appear in the arguments of a call to a recursive
-- function that is defined at the SMT level, but a symbolic array index may
-- not: only an inlined call is given the index variable itself.

datatype Nat = Zero | Succ (p: Nat);
const K: int;

function rec Even (n: Nat) returns (r: bool)
con
  decreases n;
noc
let
  r = match n with | Zero : true | Succ(m) : not Even(m) end;
tel

node main (ns: Nat^K) returns ();
var a: bool^K;
let
  a[i] = Even(ns[i]);
  check a[0];
tel
