-- A pattern variable bound by matching the quantified variable depends on it
-- without mentioning it, so the condition 'v = c' of the guard depends on k
-- and changes over time, and the node call is rejected, as in
-- lazy_quant_guard_call_time_varying.lus: for k = Some(true), 'prev(x)' would
-- be the value of x when c last held (issue #1849)

datatype O = Some (f: bool) | None;

node prev (x: int) returns (y: int);
let
  y = x -> pre x;
tel

node main (c: bool; x: int) returns ();
let
  check forall (k: O)
    (match k with
     | Some(v) : (v = c ==> (prev(x) > 0) = (x > 0))
     | None : true end);
tel
