-- A decreases measure that calls a recursive function. A call in a measure
-- must be inlined, since the measure is a term over the inputs of the
-- function, and a recursive function cannot be (issues #1600 and #1606).
function rec Len(x: int) returns (r: int);
con decreases x; noc
let
  r = when x <= 0 then 0 else 1 + Len(x - 1);
tel

function rec F(x: int) returns (r: int);
con decreases Len(x); noc
let
  r = when x <= 0 then 0 else F(x - 1);
tel
