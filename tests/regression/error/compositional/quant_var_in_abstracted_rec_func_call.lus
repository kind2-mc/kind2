-- In a compositional analysis a recursive function with a contract is
-- abstracted by that contract: its functional symbol is uninterpreted,
-- constrained by the contract at the arguments of its instances only. A call
-- to it applied to a quantified variable is rejected, since the symbol would
-- stand for an arbitrary function under the quantifier. Outside of
-- compositional analyses the function is defined at the SMT level and the
-- call is accepted (see success/rec_quantified_call_contract.lus).

datatype Nat = Zero | Succ (p: Nat);

function rec Even (n: Nat) returns (r: bool)
con
  decreases n;
  guarantee r or not r;
noc
let
  r = match n with | Zero : true | Succ(m) : not Even(m) end;
tel

node main (x: bool) returns (y: bool);
let
  y = x;
  check forall (n: Nat) Even(n) or not Even(n);
tel
