-- A pattern variable that shadows a constant changes over time, so a guard
-- that mentions it does too, and a temporal operand under it is abstracted
-- into a call to a node, which a quantified variable in a condition of the
-- guard that changes over time does not allow (issues #1837, #1849)

datatype O = Some(f: int) | None;

const c: int = 0;

node N (const x: O; y: int) returns (ok: bool);
let
  ok = true;
  check forall (j: int) (match x with | Some(c) : (c = j ==> (true -> pre y > 0)) | None : true end);
tel
