-- Integer division and modulo follow the Euclidean definition of SMT-LIB:
-- 'm mod n' is never negative, so 'm div n' rounds towards negative infinity
-- for a positive divisor and towards positive infinity for a negative one
-- (https://github.com/kind2-mc/kind2/issues/978).
--
-- Kind 2 used to evaluate a 'div' between constants with OCaml's native
-- operator, which rounds towards zero as C does, while the SMT solver
-- follows the Euclidean definition: '(-1) div 100 = -1' was reported
-- falsifiable, with the folded constant having the value 0.

const Q1: int = (-1) div 100;
const R1: int = (-1) mod 100;
const Q2: int = (-7) div 2;
const R2: int = (-7) mod 2;
const Q3: int = 7 div (-2);
const R3: int = 7 mod (-2);
const Q4: int = (-7) div (-2);
const R4: int = (-7) mod (-2);

node top (x, y: int) returns (q, r: int);
let
  q = x div y;
  r = x mod y;

  -- Constants folded by the frontend
  check "const_m1_div_100" (-1) div 100 = -1;
  check "const_m1_mod_100" (-1) mod 100 = 99;
  check "const_m7_div_2" (-7) div 2 = -4;
  check "const_m7_mod_2" (-7) mod 2 = 1;
  check "const_7_div_m2" 7 div (-2) = -3;
  check "const_7_mod_m2" 7 mod (-2) = 1;
  check "const_m7_div_m2" (-7) div (-2) = 4;
  check "const_m7_mod_m2" (-7) mod (-2) = 1;
  check "const_7_div_2" 7 div 2 = 3;
  check "const_7_mod_2" 7 mod 2 = 1;
  check "const_m8_div_2" (-8) div 2 = -4;
  check "const_m8_mod_2" (-8) mod 2 = 0;

  -- Global constants
  check "global_q1" Q1 = -1;
  check "global_r1" R1 = 99;
  check "global_q2" Q2 = -4;
  check "global_r2" R2 = 1;
  check "global_q3" Q3 = -3;
  check "global_r3" R3 = 1;
  check "global_q4" Q4 = 4;
  check "global_r4" R4 = 1;

  -- Symbolic operands, as the solver sees them
  check "sym_m1_div_100" x = -1 => x div 100 = -1;
  check "sym_m1_mod_100" x = -1 => x mod 100 = 99;
  check "sym_m7_div_2" x = -7 and y = 2 => q = -4 and r = 1;
  check "sym_7_div_m2" x = 7 and y = -2 => q = -3 and r = 1;
  check "sym_m7_div_m2" x = -7 and y = -2 => q = 4 and r = 1;

  -- The defining properties of Euclidean division
  check "identity" y <> 0 => x = y * q + r;
  check "rem_non_negative" y <> 0 => r >= 0;
  check "rem_below_divisor" y <> 0 => r < (if y > 0 then y else -y);

  -- The property of issue 978, valid for Kind 2 but not for C
  check "neg_quotient" x < 0 => x div 100 < 0;
tel
