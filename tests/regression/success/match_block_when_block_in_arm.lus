datatype T = A (v: int) | B (w: int);

node f (t: T; c: bool) returns (y: int);
let
  match t with
  | A (v):
    when c then
      y = v;
    else
      y = 0;
    end
  | B (w):
    y = w;
  end
tel

node main () returns (ok: bool);
let
  ok = f(A(5), true) = 5 and f(A(5), false) = 0 and f(B(3), true) = 3;
  check ok;
tel
