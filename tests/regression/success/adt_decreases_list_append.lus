datatype List = Cons (head: int, tail: List) | Nil;

function rec Length (l: List) returns (len: int)
con
  decreases l;
  guarantee "nonneg" len >= 0;
noc
let
  len = match l with
  | Nil : 0
  | Cons (_, tl) : 1 + Length(tl)
  end;
tel

function rec Append (l1: List; l2: List) returns (out: List)
con
  decreases l1;
  guarantee "length_additive" Length(out) = Length(l1) + Length(l2);
noc
let
  out = match l1 with
  | Nil : l2
  | Cons (h, tl) : Cons(h, Append(tl, l2))
  end;
tel

node main (l1: List; l2: List) returns ()
let
  check "append_length" Length(Append(l1, l2)) = Length(l1) + Length(l2);
tel
