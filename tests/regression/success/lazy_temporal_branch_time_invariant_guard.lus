-- A temporal operand of a lazy construct whose guard does not change over
-- time, as it only mentions quantified variables, array indices, constants and
-- constructors, is evaluated in place rather than abstracted into a call to a
-- node, so it may mention a quantified variable or a symbolic array index
-- (issue #1837)

datatype T = K | L;

const C: int;

node main (const n: int; s: int; a: int^n) returns (b: int^n; A: int^n; B: bool^n; M: int^n);
const m: int = 2;
let
  b = (0 -> pre a[i] foreach i)^n;
  -- A quantified implication, equivalent to the refinement type syntax
  check "quant_impl" forall (k: int) 0 <= k and k < n ==> b[k] = (0 -> pre a[k]);
  check "quant_refinement" forall (k: int | 0 <= k and k < n) b[k] = (0 -> pre a[k]);
  check "quant_and_then" forall (k: int) (0 <= k and k < n and then (true -> pre a[k] = b[k])) = (0 <= k and k < n);
  check "quant_or_else" forall (k: int) k < 0 or k >= n or else (true -> pre a[k] = b[k]);
  check "quant_when" forall (k: int) (when 0 <= k and k < n then (0 -> pre a[k]) else 0) = (if 0 <= k and k < n then b[k] else 0);
  -- A guard on a local constant and a free constant
  check "local_const" forall (k: int) 0 <= k and k < m and m <= n ==> (true -> pre a[k] = b[k]);
  check "free_const" C > 0 ==> (true -> pre (s + C) = pre s + C);

  -- A sliding window, in comprehensions of symbolic size
  A = (when i = 0 then s else (-1 -> pre A[i-1]) foreach i)^n;
  check "slide_when" n > 1 ==> (true -> A[1] = pre s);
  B = (i = 0 or else (false -> pre B[i-1]) foreach i)^n;
  check "slide_or_else" n > 1 ==> (true -> B[1]);
  M = (match (if i = 0 then K else L) with | K : s | L : (-1 -> pre M[i-1]) end foreach i)^n;
  check "slide_match" n > 1 ==> (true -> M[1] = pre s);
tel
