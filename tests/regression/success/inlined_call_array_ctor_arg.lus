-- An inlined call with an argument that refers to an identifier generated
-- by the normalizer, such as an array constructor (issue #1819)

function get (const n: int; p: int^n; k: int) returns (v: int);
let
  v = p[k];
tel

function get3 (p: int^3; k: int) returns (v: int);
let
  v = p[k];
tel

node mk (x: int) returns (a: int^3);
let
  a = x^3;
tel

function mkf (x: int) returns (a: int^3);
var b: int^3;
let
  b = x^3;
  a = b;
tel

function imported fu (x: int) returns (a: int^3);

node main (const n: int; c: bool; P: int^3) returns (A, B, C: int^n);
let
  -- A call applied to a quantified variable
  check forall (k: int) 0 <= k and k < 3 => get3(0^3, k) = 0;
  -- A call applied to the index variable of a comprehension of symbolic size
  A = (get(n, 0^n, i) foreach i)^n;
  check forall (j: int) 0 <= j and j < n => A[j] = 0;
  -- An argument that contains an array constructor
  B = (get(n, (-1)^n -> pre B, i) foreach i)^n;
  check forall (j: int) 0 <= j and j < n => B[j] = -1;
  -- An array constructor in the arguments of a nested inlined call
  C = (get(n, 2^n, get(n, 0^n, i) + i) foreach i)^n;
  check forall (j: int) 0 <= j and j < n => C[j] = 2;
  -- An array literal, whose local is reused by the second call
  check forall (k: int) 0 <= k and k < 3 => get3([1,1,1], k) = 1;
  check forall (k: int) 0 <= k and k < 3 => get3([1,1,1], k) > 0;
  -- The output of a call to a node, and to a function, whose instance is
  -- shared by the second call
  check forall (k: int) 0 <= k and k < 3 => get3(mk(0), k) = 0;
  check forall (k: int) 0 <= k and k < 3 => get3(mkf(0), k) = 0;
  check forall (k: int) 0 <= k and k < 3 => get3(mkf(0), k) >= 0;
  -- Arguments that contain them
  check forall (k: int) 0 <= k and k < 3 =>
    get3(if c then mk(0) else [0,0,0], k) = 0;
  check forall (k: int) 0 <= k and k < 3 =>
    get3(if c then fu(1) else [1,1,1], k) = (if c then get3(fu(1), k) else 1);
  check forall (k: int) 0 <= k and k < 3 =>
    get3(0^3 -> pre P, k) = (0 -> pre P[k]);
tel
