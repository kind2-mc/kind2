-- An inlined call with an array constructor in its arguments (issue #1819)

function get (const n: int; p: int^n; k: int) returns (v: int);
let
  v = p[k];
tel

function get3 (p: int^3; k: int) returns (v: int);
let
  v = p[k];
tel

node main (const n: int) returns (A, B, C: int^n);
let
  -- A call applied to a quantified variable
  check forall (k: int) 0 <= k and k < 3 => get3(0^3, k) = 0;
  -- A call applied to the index variable of a comprehension of symbolic size
  A = (get(n, 0^n, i) foreach i)^n;
  check forall (j: int) 0 <= j and j < n => A[j] = 0;
  -- An argument that contains an array constructor
  B = (get(n, (-1)^n -> pre B, i) foreach i)^n;
  check forall (j: int) 0 <= j and j < n => B[j] = -1;
  -- An array constructor in the arguments of a nested inlined call
  C = (get(n, 2^n, get(n, 0^n, i) + i) foreach i)^n;
  check forall (j: int) 0 <= j and j < n => C[j] = 2;
tel
