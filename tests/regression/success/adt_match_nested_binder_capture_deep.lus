datatype Box = B (v: int);
datatype Pair = P (x: Box, y: Box);

node N (b: Box; p: Pair) returns (y: int)
let
  y = match b with
      | B (v) : (match p with
                 | P (b, v2) : (match b with
                                | B (v) : v2.v - v
                                end)
                 end)
      end;
tel

node main (b: Box; p: Pair) returns ()
let
  check N(b, p) = p.y.v - p.x.v;
tel
