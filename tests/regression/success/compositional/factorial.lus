-- The guarantee needs induction over the recursion: the contract of Fact
-- abstracts its recursive call in a compositional analysis, which is what
-- makes it provable.
function rec Fact(n: int) returns (f: int);
(*@contract
  guarantee "fact is positive" f > 0;
  decreases n;
*)
let
  f = when n <= 0 then 1 else n * Fact(n - 1);
tel