-- The guarantee of MapInc and the check in main rest on the contracts of
-- Length and MapInc abstracting the calls, which a compositional analysis
-- does; the guarantee needs induction over the recursion.
datatype List = Cons (head: int, tail: List) | Nil;

function rec Length (l: List) returns (len: int)
con
  decreases l;
  guarantee "nonneg" len >= 0;
noc
let
  len = match l with
  | Nil : 0
  | Cons (_, tl) : 1 + Length(tl)
  end;
tel

function rec MapInc (l: List) returns (out: List)
con
  decreases l;
  guarantee "length_preserved" Length(out) = Length(l);
noc
let
  out = match l with
  | Nil : Nil
  | Cons (h, tl) : Cons(h + 1, MapInc(tl))
  end;
tel

node main (l: List) returns ()
let
  check "map_preserves_length" Length(MapInc(l)) = Length(l);
tel
