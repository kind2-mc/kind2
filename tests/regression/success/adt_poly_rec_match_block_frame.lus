datatype List<T> = Nil | Cons (hd: T, tl: List<T>);

node f (x: List<int>) returns (y: int);
let
  frame (y)
    y = 0;
  let
    match x with
    | Cons (a, r):
      y = a;
    end
  tel
  --%PROPERTY (Nil?(x) => y = (0 -> pre y));
tel

node main (i: int) returns (ok: bool);
let
  ok = f(Cons(i, Nil@<int>)) = i;
  check ok;
tel
