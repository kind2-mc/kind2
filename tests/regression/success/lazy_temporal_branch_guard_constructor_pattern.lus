-- A nullary constructor named in the pattern of an arm is not a binder, so a
-- guard that mentions it and a quantified variable does not change over time,
-- and the temporal operand under it is evaluated in place (issue #1837)

datatype T = K | L;

node N (const x: T; y: int) returns (ok: bool);
let
  ok = true;
  assert y > 0;
  check "p" forall (j: int) (match x with | K : ((j = 0 and x = K) ==> (true -> pre y > 0)) | L : true end);
tel
