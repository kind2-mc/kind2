node sum_ge_10 (i: int) returns (out: bool) ;
var sum: int ;
let
  sum = i + (0 -> pre sum) ;
  out = sum >= 10 ;
tel

node clocked_call (i: int) returns (safe_tmp: bool) ;
var i_pos, pre_tmp: bool;
let
  i_pos = i >= 0 ;
  pre_tmp = false -> pre safe_tmp  ;
  safe_tmp = when i_pos then sum_ge_10(i) else pre_tmp ;
tel
