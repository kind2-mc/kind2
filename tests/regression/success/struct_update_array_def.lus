node AtIndexVar(x: int^3; v: int) returns (y: int^3);
let
  y[i] = (x[i := v])[i];
  check forall (k: int) ((k >= 0 and k < 3) => (y[k] = v));
tel

node FrameAtOtherIndex(x: int^3; v: int) returns (y: int^3^3);
let
  y[i][j] = (x[i := v])[j];
  check "updated" forall (k: int) ((k >= 0 and k < 3) => (y[k][k] = v));
  check "unchanged" forall (k: int; l: int)
    ((k >= 0 and k < 3 and l >= 0 and l < 3 and k <> l) => (y[k][l] = x[l]));
tel

node NestedAtIndexVar(x: int^3; v: int; w: int) returns (y: int^3);
let
  y[i] = ((x[i := v])[i := w])[i];
  check forall (k: int) ((k >= 0 and k < 3) => (y[k] = w));
tel
