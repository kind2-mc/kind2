datatype T = A (v: int) | B (w: int);

node imported nd () returns (t: T);
(*@contract guarantee t = A (1) or t = B (2); *)

node main () returns (ok: bool);
var r: int^4;
let
  r = ((match nd () with
        | A (v) : v + i
        | B (w) : w + i
        end) foreach i)^4;
  ok = true;
  check "ok" r[0] >= 1;
tel
