node count1 (m: bool) returns (A: int^3);
let
  frame (A)
    A = (any { v: int | v >= 0 } foreach i)^3;
  let
    when m then
      A = (last A[i] + 1 foreach i)^3;
    end
  tel
  check "nonneg1" A[0] >= 0;
tel

node count2 (m: bool) returns (B: int^2^2);
let
  frame (B)
    B = (any { v: int | v >= 0 } foreach i, j)^2^2;
  let
    when m then
      B = (last B[i][j] + 1 foreach i, j)^2^2;
    end
  tel
  check "nonneg2" B[0][1] >= 0;
tel

-- A deterministic array initialization referenced through 'last', independent
-- of 'any'.
node count3 (m: bool) returns (A: int^3);
let
  frame (A)
    A = (0 foreach i)^3;
  let
    when m then
      A = (last A[i] + 1 foreach i)^3;
    end
  tel
  check "nonneg3" A[0] >= 0;
tel
