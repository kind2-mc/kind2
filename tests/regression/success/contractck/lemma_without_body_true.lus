-- The contract of a lemma without a body that states a true fact about its
-- inputs is realizable.
function f (n: int) returns (m: int);
let
  m = n + 1;
tel

lemma f_increasing (n: int)
con
  guarantee f(n) > n;
noc

node main (x: int) returns (ok: bool);
let
  f_increasing(x);
  ok = f(x) > x;
  check ok;
tel
