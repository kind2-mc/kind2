-- A call applied to quantified variables is compiled to an application of the
-- functional symbol of the callee, and the contract checker rests on
-- quantifier elimination, which does not take an uninterpreted function. The
-- check must decline the node rather than fail in the solver.

datatype Nat = Zero | Succ (p: Nat);

function rec Even (n: Nat) returns (r: bool)
con
  decreases n;
noc
let
  r = match n with | Zero : true | Succ(m) : not Even(m) end;
tel

function imported P (x: Nat) returns (r: bool)
con
  guarantee r = (forall (n: Nat) Even(Succ(n)) = not Even(n));
noc

node main (x: Nat) returns (y: bool);
let
  y = P(x);
  check "c" y or not y;
tel
