-- Calls to functions over arrays of symbolic size, whose size is a constant
-- input of the function (issue #1611). The bounds of the call's outputs, and
-- those of its array arguments in the congruence instances of an imported
-- function, used to refer to the constant input of the callee rather than to
-- the actual argument of the call, which was undeclared in the solver.
-- test_calls_symbolic_array_size.py runs the models of the issue with
-- restricted engines.
function Id(const k: int; a: int^k) returns (b: int^k);
let
  b = a;
tel

function imported P(const L: int; a: int^L) returns (r: bool);
(*@contract
  guarantee r = (a[0] >= 0);
*)

function rec Sum(const L: int; a: int^L; i: int) returns (s: int);
(*@contract
  decreases i;
*)
let
  s = if i <= 0 or i > L then 0 else a[i-1] + Sum(L, a, i-1);
tel

node N(const L: int; a: int^L; b: int^2) returns ();
var c: int;
let
  assert a[0] >= 0;
  c = 0 -> pre c + 1;
  check "id_eq" Id(2, b) = b;
  check "id_eq_symbolic" Id(L, a) = a;
  check "imported" P(L, a);
  check "rec" Sum(L, a, 0) = 0;
  check "counter" c >= 0;
tel
