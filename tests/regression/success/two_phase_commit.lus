datatype Option<T> = Some (value: T) | None;

node imported nondet() returns (r: bool);

type Vote = enum {Yes, No};

type Decision = enum {Commit, Abort};

type HostId;

datatype Token_Holder = CoordinatorHost | ParticipantHost (id: HostId) | NoHost;

const Preference : subtype { m : map<HostId,Vote> | forall (h:HostId) h in m };

datatype Message =
  | VoteReqMsg
  | VoteMsg (id: HostId, vote: Vote)
  | DecisionMsg (decision: Decision);

type MsgSet = set<Message>;

node Network(send: Option<Message>) returns 
  (recv: Option<Message>; sentMsgs: MsgSet);
var prevSentMsgs: MsgSet;
let
  prevSentMsgs = {}@<Message> -> pre sentMsgs;
  frame (sentMsgs)
    sentMsgs = {}@<Message>;
  let
    when Some?(send) then
      sentMsgs = prevSentMsgs + {send.value};
    end
  tel
  recv = any { m: Option<Message> | Some?(m) ==> m.value in prevSentMsgs };
tel

function imported AllVotesCollected(votes: map<HostId,Vote>) returns (r: bool);
(*@contract
  guarantee r = (forall (i: HostId) i in votes);
*)

function imported GetDecision(votes: map<HostId,Vote>) returns (d: Decision);
(*@contract
  (* 'votes[i]' is unconstrained where 'i' is not a key of 'votes', so the
     reads are guarded by membership: 'i in votes and votes[i]=Yes' is false
     at an absent key whatever the map holds there. The second guarantee is
     the negation of the first, so that a decision exists for every map. *)
  guarantee (forall (i: HostId) i in votes and votes[i]=Yes) = (d = Commit);
  guarantee (not (forall (i: HostId) i in votes and votes[i]=Yes)) = (d = Abort);
*)

node Coordinator(nw_recv: Option<Message>)
  returns (nw_send: Option<Message>; decision: Option<Decision>;
           votes: map<HostId,Vote>);
var sender: HostId;
let
  sender =
    when Some?(nw_recv) and then VoteMsg?(nw_recv.value)
    then nw_recv.value.id else any@<HostId>;
  frame (votes, nw_send, decision)
    decision = None@<Decision>;
    votes = map[]@<HostId,Vote>;
    nw_send = None@<Message>;
  let
    when (Some?(nw_recv) and then VoteMsg?(nw_recv.value)) then
      votes = (last votes)[sender := nw_recv.value.vote];
      when AllVotesCollected(votes) then
        decision = Some(GetDecision(votes));
        nw_send = Some(DecisionMsg(GetDecision(votes)));
      else
        nw_send = None@<Message>;
      end
    else
      when (nondet()) then
        nw_send = Some(VoteReqMsg);
      else
        nw_send = None@<Message>;
      end
    end
  tel
tel

node Participant(id: HostId; nw_recv: Option<Message>)
  returns (nw_send: Option<Message>; decision: Option<Decision>);
let
  frame (nw_send, decision)
    decision = None@<Decision>;
    nw_send = None@<Message>;
  let
    when (Some?(nw_recv) and then VoteReqMsg?(nw_recv.value)) then
      nw_send = Some(VoteMsg(id, Preference[id]));
      when Preference[id] = No then
        decision = Some(Abort);
      else
        decision = None@<Decision>;
      end
    else
      when (Some?(nw_recv) and then DecisionMsg?(nw_recv.value)) then
        decision = Some(nw_recv.value.decision);
        nw_send = None@<Message>;
      else
        nw_send = None@<Message>;
        decision = None@<Decision>;
      end
    end
  tel
tel

function imported AllWithDecisionAgreeWithThisOne(
  coord_decision: Option<Decision>;
  partic_decision: map<HostId,Decision>;
  decision: Decision
) returns (
  r: bool
);
(*@contract
  guarantee r = (
    (Some?(coord_decision) ==> coord_decision.value = decision) and
    (forall (i: HostId) i in partic_decision ==> partic_decision[i] = decision)
  );
*)

node DistributedSystem(tk_holder: Token_Holder) returns (
  coord_decision: Option<Decision>; partic_decision: map<HostId,Decision>
);
(*@contract
  assume "No one's turn initially, then always somebody's turn"
    NoHost?(tk_holder) -> not NoHost?(tk_holder);

  guarantee "SafetyAC1"
    AllWithDecisionAgreeWithThisOne(
      coord_decision, partic_decision, Commit)
    or
    AllWithDecisionAgreeWithThisOne(
      coord_decision, partic_decision, Abort);

  guarantee "SafetyAC3" (
    (exists (hostid:HostId) Preference[hostid] = No)
    =>
    AllWithDecisionAgreeWithThisOne(
      coord_decision, partic_decision, Abort)
  );

  guarantee "SafetyAC4" (
    (forall (hostid:HostId) Preference[hostid] = Yes)
    =>
    AllWithDecisionAgreeWithThisOne(
      coord_decision, partic_decision, Commit)
  );
*)
var coord_send, partic_send: Option<Message>;
var network_send, network_recv: Option<Message>;
var decision_id: Option<Decision>;
var votes: map<HostId,Vote>; -- probe
var sentMsgs: MsgSet; -- probe

var votesCollected: bool;
var decisionOfVotes: Decision;

let
  frame (coord_send, coord_decision, votes)
    coord_send = None@<Message>;
    coord_decision = None@<Decision>;
    votes = map[]@<HostId,Vote>;
  let
    when (CoordinatorHost?(tk_holder)) then
      coord_send, coord_decision, votes = Coordinator(network_recv);
    end
  tel

  frame (partic_send, decision_id)
    partic_send = None@<Message>;
    decision_id = None@<Decision>;
  let
    when (ParticipantHost?(tk_holder)) then
      partic_send, decision_id = Participant(tk_holder.id, network_recv);
    end
  tel

  frame (partic_decision)
    partic_decision = map[]@<HostId,Decision>;
  let
    when (ParticipantHost?(tk_holder) and Some?(decision_id)) then
      partic_decision = (last partic_decision)[tk_holder.id := decision_id.value];
    end
  tel

  if CoordinatorHost?(tk_holder) then
    network_send = coord_send;
  elsif ParticipantHost?(tk_holder) then
    network_send = partic_send;
  else -- NoHost?(tk_holder)
    network_send = None@<Message>;
  fi

  network_recv, sentMsgs = Network(network_send);

  votesCollected = AllVotesCollected(votes);
  decisionOfVotes = GetDecision(votes);

  check "Vote Messages Agree With Participant Preferences"
    forall (msg: Message) (msg in sentMsgs and VoteMsg?(msg)) ==>
      msg.vote = Preference[msg.id];

  check "Coordinator State Supported By Vote"
    forall (idx:HostId) idx in votes => 
      VoteMsg(idx, votes[idx]) in sentMsgs;

  check "Decision Msgs Agree With Decision"
    forall (msg: Message) (msg in sentMsgs and DecisionMsg?(msg)) ==>
      (votesCollected and
       decisionOfVotes = msg.decision);

  check "Participant Commit Decision Agree With Decision Msg"
    Some?(decision_id) and then decision_id.value = Commit =>
      DecisionMsg(Commit) in sentMsgs;

  check "Participant Decision Agree With Participant Preferences"
    ((forall (idx: HostId) Preference[idx]=Yes) and Some?(decision_id)) ==>
      decision_id.value = Commit;
tel
