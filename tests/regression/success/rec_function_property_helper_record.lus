type R = struct {f: subtype {w: int | w >= 0}};
function G(n: int) returns (y: int); let y = (R {f = 0}).f; tel
function rec F(n: int) returns (y: int);
(*@contract decreases n; *)
let y = when n <= 0 then 0 else F(n - 1); check G(n) = 0; tel
node N(x: int) returns (ok: bool); let ok = true; check forall (i: int) i <= 0 => F(i) = 0; tel
