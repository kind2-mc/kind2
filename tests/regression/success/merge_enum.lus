type t = enum {A, B, C};

node integr (e: int) returns (s: int);
let
  s = e + (0 -> pre s); 
tel

node id (e: int) returns (s: int);
let
  s = e;
tel

node test (e: int; cl: t) returns
 (s, t1: int);
let 
  s = integr(e);
  
  cond
    | cl = A: t1 = s;
    | cl = C: t1 = s;
    otherwise: t1 = s - 1;
  end
  
  --%PROPERTY t1 <= s;
tel

  
