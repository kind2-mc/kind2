datatype Nat = Succ (pred: Nat) | Zero;

function pair (n: Nat) returns (a: Nat; b: Nat);
let
  a = n;
  b = n;
tel

function rec F (m: Nat; k: Nat; n: Nat) returns (out: int)
con decreases n; noc
let
  out = match n with
  | Zero : 0
  | Succ (p) : 1 + F(pair(p), p)
  end;
tel

node main (n: Nat) returns ()
let
  check F(n, n, n) = F(n, n, n);
tel
