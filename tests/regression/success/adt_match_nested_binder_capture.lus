datatype Box = B (v: int);
datatype BoxBox = BB (inner: Box);

node N (b: Box; c: BoxBox) returns (y: int)
let
  y = match b with
      | B (v) : (match c with
                 | BB (b) : v
                 end)
      end;
tel

node main (b: Box; c: BoxBox) returns ()
let
  check N(b, c) = b.v;
tel
