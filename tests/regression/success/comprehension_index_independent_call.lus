-- A node call in an array comprehension whose operands do not mention the
-- index variable, and that is under no lazy construct whose condition does, is
-- made once, rather than once per index, even when another call of the
-- equation takes the index variable (#1755)
node F() returns (c: int);
let
  c = 1 -> pre c + 1;
  check "f" c >= 1;
tel

node G(x: int) returns (c: int);
let
  c = x;
  check "g" c = x;
tel

node H(x, y: int) returns (c: int);
let
  c = x + y;
tel

node main(m: int) returns (A, B, C, D, P, Q: int^3; E: int^2^3);
let
  -- Under an eager conditional
  A = (if F() = 1 then G(i) else 0 foreach i)^3;
  -- In the condition of a lazy construct
  B = (when F() = 1 then G(i) else 0 foreach i)^3;
  -- As an operand of a call whose other operands take the index variable
  C = (G(G(m)) + G(i) foreach i)^3;
  -- Under a lazy construct whose condition takes the index variable: made
  -- only at the indices the condition selects, so once per index
  D = (when m = i then G(m) else 0 foreach i)^3;
  -- Over several index variables, a call that takes one of them only
  E = (G(j) + G(m) foreach i, j)^2^3;
  -- As an operand of a call that takes the index variable
  P = (H(F(), i) foreach i)^3;
  -- In the condition of a lazy construct, next to the index variable: the
  -- guarded call is made once per index, the call in the condition once
  Q = (when F() = 1 and m = i then G(i) else 0 foreach i)^3;
  check "A" A[2] = (if F() = 1 then 2 else 0);
  check "B" B[1] = (if F() = 1 then 1 else 0);
  check "C" C[2] = m + 2;
  check "D" D[0] = (if m = 0 then m else 0);
  check "E" E[2][1] = 1 + m;
  check "P" P[2] = F() + 2;
  check "Q" Q[1] = (if F() = 1 and m = 1 then 1 else 0);
tel
