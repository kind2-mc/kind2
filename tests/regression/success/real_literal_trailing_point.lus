-- Real literals with a trailing point, optionally followed by an
-- exponent, as accepted by the Lustre V6 compiler (issue #1896)

type complex = struct { re: real; im: real };

const i: complex = complex { re = 0. ; im = 1. };

node test () returns ()
let
