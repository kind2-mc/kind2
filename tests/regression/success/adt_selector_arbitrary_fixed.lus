-- A selector applied to a value built with another constructor yields an
-- arbitrary value that is fixed for a given ADT value: reading it twice, or
-- from two equal values, gives the same result. Under a lazy construct that
-- establishes the constructor (when, and then, or else, ==>, a match arm)
-- the selector is the payload itself.

datatype D = A (a: int) | B (b: bool) | C;

node main(x, y: D; i: int) returns (ok: bool);
var z: D; m: int;
let
  check "fixed for a value"        x.a = x.a;
  check "function of the value"    (x = y) => x.a = y.a;
  z = if i > 0 then A(i) else B(true);
  check "constructed value"        z.a = z.a;

  check "when expression"          (when A?(x) then x.a else 0) = (when A?(x) then x.a else 0);
  check "and then"                 (A?(x) and then x.a = i) = (A?(x) and then x.a = i);
  check "or else"                  (not A?(x) or else x.a = i) = (A?(x) ==> x.a = i);
  check "lazy implication"         (A?(x) ==> x.a = i) => (A?(x) => x.a = i);
  m = match x with
    | A(v) : v
    | B(_) : x.a
    | C : 0
  end;
  check "match arm"                A?(x) => m = x.a;

  frame (ok)
    ok = true;
  let
    when A?(x) then
      ok = x.a = x.a;
    end
  tel
tel
