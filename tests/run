#!/usr/bin/env bash

# jsonschema is what the JSON output of the regression tests is checked with
# (see output_schema.py). It is requested here rather than installed, so that a
# checkout without uv still runs: the check is then skipped, and the session
# says so at the end.
if command -v uvx >/dev/null 2>&1
then
	uvx --with jsonschema pytest "$@"
else
	pytest "$@"
fi
