datatype List = Cons (head: int, tail: List) | Nil;

function rec F (n: List; m: List) returns (out: int)
con decreases n; noc
let
  out = match n with
  | Nil : 0
  | Cons (h, tl) :
      (match m with
       | Nil : 0
       | Cons (h3, n) :
           (match n with
            | Nil : 0
            | Cons (h2, t2) : 1 + F(t2, m)
            end)
       end)
  end;
tel
