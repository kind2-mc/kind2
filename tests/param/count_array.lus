-- The number of true elements among the first k elements of B
opaque function rec CountTrue (const n: int; B: bool^n; k: int) returns (c: int);
(*@contract
  guarantee 0 <= c and (0 <= k => c <= k);
  decreases k;
*)
let
  c = when k <= 0 or k > n then 0
      else CountTrue(n, B, k - 1) + (if B[k-1] then 1 else 0);
tel

node count( const n : int ; B : bool^n ) returns ( C : int ) ;
  var anm1 :  int;

let
  anm1 = CountTrue(n, B, n);
  C = anm1 ;

  --%PROPERTY n > 0 => (C >= 0 and C <= n) ;
tel

const N: int = 4;
--const N: subrange [3,*] of int;

node atmone( ) returns ( ok : bool ) ;
  var B : bool^N ;
let
  B = (if i = 2 then true else true foreach i)^N;
  -- B = [false, true, true, false];
  ok = count(N, B) <= 1;

  --%PROPERTY ok;
tel
