(* 
  The file contains Lustre encodings of several examples 
  of reactive system components from the following textbook:

    Principles of Cyber-Physical Systems
    by Rajeev Alur
    MIT Press, 2015
    https://www.cis.upenn.edu/~alur/pcps.html

  Figure references are to figures in the book.

  To check or simulate a specific node make sure its definition
  contains the directive:

  --%MAIN ;

  while no other nodes do. You can deactivate the directive 
  by adding a space after --, as in:

  -- %MAIN ;
*)


----------------------
-- Auxiliary nodes
----------------------

-- The book's nondeterministic choice is the 'any' operator: 'any@<bool>'
-- picks, at each step of the computation, one of the two Boolean values;
-- 'any { z: real | a <= z and z <= b }' picks a real (actually, rational)
-- value from the closed interval [a,b], provided that a <= b.

-- First(b) is constant stream consisting of the first value of b. 
node First<T>(inp: T) returns (f: T) ;
let
  f = inp -> pre f ;
tel


----------------------
-- Figure 2.1
----------------------

-- One-step delay component
-- For all steps > 0, Delay(init, inp) is the previous value of inp;
-- at step 0 it is init.
node Delay<T>(init, inp: T) returns (out: T) ;
  var x: T ;
let
  out = x ;
  x = init -> pre inp ;
tel


----------------------
-- Figure 2.2
----------------------

-- Switch(press) models a timed light switch where the light stays
-- on for at most 10 steps unless it is switched off before.
-- The input button is interpreted as an off or an on command 
-- depending on whether the light was respectively on or off.

type status = enum {on, off};

node Switch(press: bool) returns (mode: status);
  var x: subrange [0, 10] of int ;
let
  if true -> false then 
    mode = off ;
  elsif false -> (pre mode = off) then
    if press then
      mode = on ;
    else
      mode = off ;
    fi
  elsif press or x >= 10 then
    mode = off ;
  else
    mode = on ;
  fi

  if true -> false then
    x = 0 ;
  elsif false -> (pre mode = off) then
    x = 0 -> pre x ;
  elsif press or (0 -> pre x) >= 10 then
    x = 0 ;
  else
    x = (0 -> pre x) + 1 ;
  fi
tel


----------------------
-- Figure 2.4
----------------------

-- The type of the input values restricts their range to natural numbers
-- during verification, obviating the need for assumptions on them:
-- Kind 2 reads a refinement type on an input as an assumption.
type nat = subrange [0, *] of int ;

node Comparator(in1, in2: nat) returns (out: bool) ;
let
  out = (in1 >= in2) ;
tel


----------------------
-- Event type
----------------------

-- The book's event type is parameterized by the type of the value carried
-- by a present event, so it is a polymorphic datatype in Kind 2.
-- The book's presence test 'e?' is the tester 'Present?(e)', and its dual
-- is 'Absent?(e)'.

datatype event<T> = Absent | Present (value: T) ;

-- An event carrying no value is an event over the type with a single value,
-- so 'Bot' and 'Top' below respectively denote the absence and 
-- the presence of the event.

datatype unit = Unit ;
type signal = event<unit> ;

const Bot: signal = Absent@<unit> ;
const Top: signal = Present(Unit) ;


----------------------
-- Figure 2.6
----------------------

node Clocked<T>(init, inp: T; clock: signal) returns (out: T) ;
  var x: T ;
let
  out = x ;

  frame (x)
  x = init ;
  let
    if Present?(clock) then   -- if clock? then
      x = inp ;               --   x := in
    fi
  tel
tel


----------------------
-- Figure 2.5
----------------------

-- The output event of Triggered(inp) is the same as 'inp';
-- if that input is "present"; otherwise, out gets a value denoting 
-- an absent event. 
node Triggered(inp: event<bool>) returns (out: event<bool>) ;
  var x: nat ;
let
  if Present?(inp) then       -- if in? then
    out = inp ;               --   out ! in
    x = 0 -> pre x + 1 ;      --   x := x + 1
  else
    out = Absent@<bool> ;
    x = 0 -> pre x ;
  fi
tel


----------------------
-- Figure 2.7
----------------------

-- Arbiter grants input requests expressed by the events 'req1' and 'req2'.
-- At all times, a request on the first input is always granted (expressed 
-- by issuing the event gra1), if it is the only request. The policy for 
-- second input is analogous. When both inputs contain a request, one of  
-- the two is granted, with a non-deterministic choice.
--
node Arbiter(req1, req2: signal) returns (gra1, gra2: signal) ;
  var c: bool; 
let
  c = any@<bool>;

  if Present?(req1) and Present?(req2) then
    if c then
      gra1 = Top ;
      gra2 = Bot ;
    else
      gra1 = Bot ;
      gra2 = Top ;
    fi
  elsif Present?(req1) then
    gra1 = Top ;
    gra2 = Bot ;
  elsif Present?(req2) then
    gra1 = Bot ;
    gra2 = Top ;
  else
    gra1 = Bot ;
    gra2 = Bot ;
  fi

-- We expect these two properties to fail. Since the choice of which 
-- request to grant is non-derministic and so can change over time and 
-- over executions. 
check "P1.1" Present?(req1) and Present?(req2) => Present?(gra1) ; 
check "P1.2" Present?(req1) and Present?(req2) => Present?(gra2) ; 

-- We expect all the following properties to hold, i.e., to be invariant.

-- In the presence of both requests, exactly one is granted.
check "P2" Present?(req1) and Present?(req2) => Present?(gra1) xor Present?(gra2) ; 
-- In the presence of one request only, that request is granted.
check "P3.1" Present?(req1) and Absent?(req2) => Present?(gra1) ; 
check "P3.2" Present?(req2) and Absent?(req1) => Present?(gra2) ; 

-- Requests are granted only if present.
check "P4.1" Present?(gra1) => Present?(req1) ; 
check "P4.2" Present?(gra2) => Present?(req2) ; 

--% MAIN ; 
tel


-- Alternative, more compact definition of 'Arbiter'. 
node ArbiterS(req1, req2: signal) returns (gra1, gra2: signal) ;
  var first: bool;
let
  first = any@<bool>;
  gra1 = if Present?(req1) and (Absent?(req2) or first) 
         then Top else Bot ;
  gra2 = if Present?(req2) and (Absent?(req1) or not first) 
         then Top else Bot ;
tel


-- Version of 'Arbiter' where the non-deterministic choice is provided
-- by the environment as the input variable 'c'.
node Arbiter_in(c: bool; req1, req2: signal) returns (gra1, gra2: signal) ;
let
  if Present?(req1) and Present?(req2) then
    if c then
      gra1 = Top ;
      gra2 = Bot ;
    else
      gra1 = Bot ;
      gra2 = Top ;
    fi
  elsif Present?(req1) then
    gra1 = Top ;
    gra2 = Bot ;
  elsif Present?(req2) then
    gra1 = Bot ;
    gra2 = Top ;
  else
    gra1 = Bot ;
    gra2 = Bot ;
  fi
tel

-- Version of 'ArbiterS' where the non-deterministic choice is provided
-- by the environment as the input variable 'c'.
node ArbiterS_in(c: bool; req1, req2: signal) returns (gra1, gra2: signal) ;
let
  gra1 = if Present?(req1) and (Absent?(req2) or c) 
         then Top else Bot ;
  gra2 = if Present?(req2) and (Absent?(req1) or not c) 
         then Top else Bot ;
tel


-- Monitor(c, req1, req2) checks that 'Arbiter_in' and 'ArbiterS_in' are
-- _behaviorally equivalent_, i.e., provide the same output when 
-- given the same requests and the same non-deterministic decisions
-- in case of concurrent requests.  
node Monitor(c: bool; req1, req2: signal) returns (b: bool);
  var g1, g2, g1S, g2S: signal ;
let
  (g1,  g2)  = Arbiter_in(c, req1, req2) ;
  (g1S, g2S) = ArbiterS_in(c, req1, req2) ; 

  -- 'b' is true iff 'Arbiter_in' and 'ArbiterS_in' produce 
  -- the same output when fed the same input.
  b = (g1 = g1S and g2 = g2S);

  check "Arbiter and ArbiterS are behaviorally equivalent" b ;
  -- %MAIN ;
tel


----------------------
-- Figure 2.15
----------------------

-- Parallel composition of nodes is achieved by applying nodes
-- as macros. 

(*          
     +------------------------------------+
     |   DoubleDelay                      |
     |                                    |
     |  +-----------+      +-----------+  |
  inp |  |           | temp |           |  | out
 ----+->|   Delay   |----->|   Delay   |--+---->
     |  |           |      |           |  |
     |  +-----------+      +-----------+  |
     |                                    |
     +------------------------------------+
*)
node DoubleDelay<T>(init, inp: T) returns (out: T) ;
  var temp: T  ;
let
  out  = Delay@<T>(init, temp) ;
  temp = Delay@<T>(init, inp) ;
tel

-- the temp variable is actually not needed
node DoubleDelay2<T>(init, inp: T) returns (out: T) ;
let 
  out = Delay@<T>(init, Delay@<T>(init, inp)) ;
tel


----------------------
-- Figure 2.25
----------------------

-- 'Latch1' has a Boolean state represented by internal variable 'x'
-- whose initial value is provided by 'b'.
-- A set request (represented by 'set_req' being true) sets 'x' to true
-- unless there is a concurrent reset request (represented by 'reset'
-- being true). In that case, the choice between the two requests
-- is resolved with the value of b. 
-- The response to a request is delayed by one step, that is, 'x'
-- is set or reset in the step immediately following the request.
-- This is captured by the auxiliary variable 'next_x'.
-- At all times, the output is the curren value of 'x'  
node Latch1(b: bool; set_req, reset: bool) returns (out: bool) ;
  var x, next_x: bool ;
let
  out = x ;

  -- One branch per mode-switch of figure 2.25; in the last one neither
  -- request is issued, so the state is carried over unchanged.
  if reset and set_req then
    next_x = b ;
  elsif reset then
    next_x = false ;
  elsif set_req then
    next_x = true ;
  else
    next_x = x ;
  fi

  x = b -> pre next_x ;
tel


-- 'Latch2' has the same behavior as 'Latch1' but its definition
-- is more idiomatic in Kind 2.
-- 'out' can be used as both the output and the state variable
-- (so no 'x' is needed). Also, the next value of 'out', provided
-- by auxiliary variable 'next_out', can be defined simply by
-- stating when exactly it is supposed to be 'true'.
node Latch2(b: bool; set_req, reset: bool) returns (out: bool) ;
  var next_out: bool ;
let
  out = b -> pre next_out ;
  
  next_out = (set_req and (not reset or b)) or 
             (not set_req and not reset and out) ;
tel


-- 'Observer2' checks that 'Latch1' and 'Latch2' are behaviorally
-- equivalent. Its ouput 'p' is constantly 'true' if and only if
-- the two nodes are equivalent. 
node Observer2(b, set_req, reset: bool) returns (p: bool);
let
  p = (Latch1(b, set_req, reset) = Latch2(b, set_req, reset)) ; 

  check "Latch1 and Latch2 are behav. equivalent" p;
  -- %MAIN ;
tel


-- This version of Latch makes its non-deterministic decisions
-- internally, instead of having them externally provided.
node Latch(set_req, reset: bool) returns (out: bool) ;
  var next_out, b: bool ;
let
  b = any@<bool> ;

  out = b -> pre next_out ;
  
  next_out = (set_req and (not reset or b)) or 
             (not set_req and not reset and out) ;
tel


----------------------
-- Figure 2.26
----------------------
(*
       +--------------------------------------------------------------+
       |                                                              |
       |   +--------------------------------------------------------+ |
       |   |                                              +-------+ | |
       | +-|-----------------------------------|``-.  set |       | | |
       | | |                          |`-._    |    :---->|       | | |
       | | +->|``-.                +--|   _]o--|..-`      | Latch | | |
       | |    |    :--+----\``-.   |  |.-`          reset |       |-+----> out
  inc ---+----|..-`   |     )   :--+--------------------->|       |   |
       |              | +--/..-`                          +-------+   |
       |              | |                                             |
start ------------------+                OneBitCounter                |
       |              |                                               |
       +--------------+-----------------------------------------------+
                      |     
                      v carry
*)
-- 'OneBitCounter' is a stateful 1-bit counter implemented using 
-- the latch component modeled by 'Latch'.
-- The counter goes from 0 (actually, to 'false') to 1 (actually, 'true')
-- with a carry value of 0, or from 1 to 0 with a carry value of 1 when
-- the increment signal 'inc' is true.
-- It is reset to 0 (actually, to 'false') when the start signal is true.
-- The initial value of the counter is arbitrary (as provided by 'Latch')
node OneBitCounter(inc, start: bool) returns (out, carry: bool) ;
  var set_req, reset: bool;
let
  out = Latch(set_req, reset) ;

  set_req = inc and not reset ; 

  reset = carry or start ;

  carry = inc and out ;
tel


----------------------
-- Figure 2.27
----------------------

-- 'ThreeBitCounter' implements a 3-bit resettable counter
-- by cascading three 1-bit counters. 
-- The output is three Boolean values standing for the three bits, 
-- with out0 being the least significant one.
node ThreeBitCounter(inc, start: bool) 
returns (out0, out1, out2: bool) ;
  var carry0, carry1, carry2: bool;
let
  (out0, carry0) = OneBitCounter(inc,    start) ;
  (out1, carry1) = OneBitCounter(carry0, start) ;
  (out2, carry2) = OneBitCounter(carry1, start) ;
  -- %MAIN ;
tel


-- 'DelayedCounter' is a delayed, resettable integer counter 
-- that ranges from 0 to 7. Its initial value is 0.
node DelayedCounter(inc, start: bool) returns (n: subrange [0, 7] of int) ;
  var next: subrange [0, 7] of int ;
let
  if start then
    next = 0 ;
  elsif inc then
    if n = 7 then
      next = 0 ;
    else
      next = n + 1 ;
    fi
  else
    next = n ;
  fi

  n = 0 -> pre next ; 
tel


------------------------
-- bits to ints to bits
------------------------

function ToBit(b: bool) returns (n: subrange [0, 1] of int) ;
let
   if b then
     n = 1 ;
   else
     n = 0 ;
   fi
tel

-- ToInt(b2, b1, b0) computes the integer denoted
-- by bit string b2b1b0 when seen as a binary number 
function ToInt(b2, b1, b0: bool) returns (n: subrange [0, 7] of int) ;
let
   n = 4 * ToBit(b2) + 2 * ToBit(b1) + ToBit(b0) ;
tel


----------------------
-- Temporal Operators
----------------------

-- At each step, Once(X) is true if X has been true 
-- at any time in the past or is true now.
node Once(X: bool) returns (Z: bool) ;
let
  Z =  X -> X or pre Z ;
tel


-- Since(X,Y) is true precisely when X has been true 
-- at some point in the past, and Y has been continuously 
-- true afterwards.
node Since(X, Y: bool) returns (Z: bool) ;
let
  Z =  X or (Y and (false -> pre Z)) ;
tel


-- 'Observer4' checks that 'ThreeBitCounter' behaves like
-- a delayed resettable counter modulo 8.
node Observer4(inc, start: bool) returns (n1, n2: int) ;
  var out0, out1, out2: bool ;
let
  (out0, out1, out2) = ThreeBitCounter(inc, start) ;

  n1 = ToInt(out2, out1, out0) ;

  n2 = DelayedCounter(inc, start) ;

  -- Only the third property holds
  check "Same count" n1 = n2 ;
  check "Same count 1" Since(start, n1 = n2) ;
  check "Same count 2" Once(start) => Since(start, n1 = n2) ;

  -- %MAIN ;
tel

